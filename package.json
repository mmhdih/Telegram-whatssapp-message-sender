{
"name": "smart-sender-enterprise",
"version": "1.0.0",
"description": "Enterprise Bulk Messaging Automation for WhatsApp & Telegram",
"main": "main.js",
"author": "SmartSender Team",
"homepage": "./",
"scripts": {
"start": "react-scripts start",
"build": "react-scripts build",
"electron:start": "electron .",
"electron:build": "electron-builder"
},
"build": {
"extends": null,
"appId": "com.smartsender.enterprise",
"productName": "SmartSender Enterprise",
"directories": {
"output": "dist"
},
"files": [
"main.js",
"build//*"
],
"win": {
"target": "portable"
},
"portable": {
"artifactName": "SmartSender-Enterprise-Portable.exe"
}
},
"dependencies": {
"lucide-react": "^0.292.0",
"react": "^18.2.0",
"react-dom": "^18.2.0"
},
"devDependencies": {
"electron": "^27.3.11",
"electron-builder": "^24.13.3",
"react-scripts": "5.0.1",
"tailwindcss": "^3.3.0"
},
"browserslist": {
"production": [
">0.2%",
"not dead",
"not op_mini all"
],
"development": [
"last 1 chrome version",
"last 1 firefox version",
"last 1 safari version"
]
}
}
