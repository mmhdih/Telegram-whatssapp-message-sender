{
  "name": "smart-sender",
  "version": "1.0.0",
  "description": "WhatsApp and Telegram Mass Sender",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.smartsender.app",
    "productName": "Smart Sender",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  }
}
