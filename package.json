{
"name": "smart-sender",
"version": "1.0.0",
"description": "WhatsApp and Telegram Mass Sender",
"main": "main.js",
"scripts": {
"start": "react-scripts start",
"build": "react-scripts build",
"electron:start": "electron .",
"electron:pack": "electron-builder --dir",
"electron:build": "electron-builder"
},
"build": {
"appId": "com.smartsender.app",
"productName": "Smart Sender",
"directories": {
"buildResources": "build"
},
"win": {
"target": "portable",
"icon": "build/icon.ico"
},
"portable": {
"artifactName": "SmartSender-Portable.exe"
}
},
"dependencies": {
"lucide-react": "^0.292.0",
"react": "^18.2.0",
"react-dom": "^18.2.0"
},
"devDependencies": {
"electron": "^27.0.0",
"electron-builder": "^24.6.4",
"react-scripts": "5.0.1",
"tailwindcss": "^3.3.0"
},
"browserslist": {
"production": [
">0.2%",
"not dead",
"not op_mini all"
],
"development": [
"last 1 chrome version",
"last 1 firefox version",
"last 1 safari version"
]
}
}